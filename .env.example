# =============================================================================
# Environment configuration — copy to ".env" and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env file. Only this example belongs in git.
# =============================================================================

# ---- Runtime ----
# "development" relaxes validation; "production" ENFORCES strong secrets below.
ENVIRONMENT=production

# ---- Security ----
# Generate a strong key:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-64-char-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Login brute-force protection (failed attempts per client IP).
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# ---- Logging / observability ----
LOG_LEVEL=INFO
# "json" (structured, for Cloud Run / Azure / AWS), "console" (human-readable),
# or leave blank to auto-pick (json in production, console otherwise).
LOG_FORMAT=
# Optional error tracking. Leave blank to disable. To enable: pip install sentry-sdk
# and set your DSN here.
SENTRY_DSN=


# ---- Database (external PostgreSQL) ----
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Managed providers (RDS / Supabase / Neon / Cloud SQL) usually require TLS —
# append ?sslmode=require. URL-encode special chars in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg://pguser:password@localhost:8001/gas_delivery?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Run `alembic upgrade head` on container start. Set to 0 for multi-replica
# deploys and run migrations once as a separate one-off step instead.
RUN_MIGRATIONS=1
# Number of Uvicorn worker processes.
WEB_CONCURRENCY=4


# ---- CORS (comma-separated list of allowed web/app origins) ----
# Use explicit origins in production, e.g. https://app.example.com,https://admin.example.com
# "*" is allowed but disables credentialed CORS.
BACKEND_CORS_ORIGINS=https://app.example.com

# ---- File uploads (delivery evidence) ----
# Evidence images are stored in the database; this only caps the upload size.
MAX_UPLOAD_SIZE_MB=10

# ---- Bootstrap admin (created on first startup if it doesn't exist) ----
FIRST_ADMIN_EMAIL=admin@yourcompany.com
FIRST_ADMIN_PASSWORD=change-me-strong-admin-password
FIRST_ADMIN_NAME=System Admin
