# Keep the build context small and never ship secrets/data into the image.
.git
.gitignore
.venv
venv
env

# Secrets & local config
.env
.env.*
!.env.example
creds
secrets.*
*.pem
*.key

# Local databases, backups & uploads (must not be baked into images)
*.db
*.sqlite
*.sqlite3
# SQLite sidecar files (write-ahead log / shared memory)
*.db-shm
*.db-wal
*.db-*
# Timestamped DB backups (e.g. delivery_app.db.bak-20260607-015003)
*.db.bak-*
*.bak
uploads/
_smoke_uploads/

# Dev / diagnostic artifacts
_diag*.py
delivery.json

# Caches & tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.vscode/
.idea/
.DS_Store
